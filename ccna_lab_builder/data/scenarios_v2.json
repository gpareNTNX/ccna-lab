  {
    "id":"27","schema_version":2,"name":"DNS Client Configuration","domain":"IP Services","difficulty":"Easy","minutes":20,
    "objective":"Configure IOS DNS client settings without requiring a DNS appliance.",
    "tasks":["Enable DNS lookup.","Configure name server 192.0.2.53 and domain ccna.lab.","Create static host server1.ccna.lab to 10.10.20.10."],
    "topology":{"nodes":[{"name":"R1-EDGE","template":"vios","left":"45%","top":"40%"}],"links":[]},
    "checks":[{"node":"R1-EDGE","command":"show running-config | include ^ip domain|^ip name-server|^ip host","assertions":[{"type":"contains","value":"ip domain lookup","label":"DNS lookup enabled"},{"type":"contains","value":"ip name-server 192.0.2.53","label":"DNS server 192.0.2.53"},{"type":"contains","value":"ip domain name ccna.lab","label":"Domain ccna.lab"},{"type":"contains","value":"ip host server1.ccna.lab 10.10.20.10","label":"Static DNS host record"}]}]
