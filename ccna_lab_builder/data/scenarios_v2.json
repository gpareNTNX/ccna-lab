[
  {
    "id": "21",
    "schema_version": 2,
    "name": "Interface Operations",
    "domain": "Network Fundamentals",
    "difficulty": "Easy",
    "minutes": 25,
    "objective": "Configure routed interfaces and verify both addressing and operational state.",
    "tasks": ["Configure R1-EDGE Gi0/0 as 10.0.12.1/30 and bring it up.", "Configure R2-HQ Gi0/0 as 10.0.12.2/30 and bring it up.", "Verify both interfaces are up/up and R1 can ping R2."],
    "topology": {"nodes": [{"name":"R1-EDGE","template":"vios","left":"25%","top":"40%"},{"name":"R2-HQ","template":"vios","left":"65%","top":"40%"}], "links": [{"a":"R1-EDGE","a_if":"Gi0/0","b":"R2-HQ","b_if":"Gi0/0"}]},
    "checks": [
      {"node":"R1-EDGE","command":"show ip interface brief","assertions":[{"type":"interface_ipv4","interface":"GigabitEthernet0/0","ip":"10.0.12.1","status":"up","protocol":"up","label":"Gi0/0 10.0.12.1 up/up"}],"remediation":["configure terminal","interface GigabitEthernet0/0","ip address 10.0.12.1 255.255.255.252","no shutdown","end"]},
      {"node":"R2-HQ","command":"show ip interface brief","assertions":[{"type":"interface_ipv4","interface":"GigabitEthernet0/0","ip":"10.0.12.2","status":"up","protocol":"up","label":"Gi0/0 10.0.12.2 up/up"}],"remediation":["configure terminal","interface GigabitEthernet0/0","ip address 10.0.12.2 255.255.255.252","no shutdown","end"]},
      {"node":"R1-EDGE","command":"ping 10.0.12.2 repeat 3","assertions":[{"type":"contains","value":"Success rate is 100 percent","label":"R1 to R2 ping 100%"}]}
    ]
  },
  {
    "id":"22","schema_version":2,"name":"CDP and LLDP Discovery","domain":"Network Fundamentals","difficulty":"Easy","minutes":25,
    "objective":"Use CDP and LLDP to verify directly connected infrastructure.",
    "tasks":["Connect SW1-CORE Gi0/1 to SW2-DIST Gi0/1.","Enable CDP and LLDP on both switches.","Verify SW1 discovers SW2 with both protocols."],
    "topology":{"nodes":[{"name":"SW1-CORE","template":"viosl2","left":"25%","top":"40%"},{"name":"SW2-DIST","template":"viosl2","left":"65%","top":"40%"}],"links":[{"a":"SW1-CORE","a_if":"Gi0/1","b":"SW2-DIST","b_if":"Gi0/1"}]},
    "checks":[
      {"node":"SW1-CORE","command":"show cdp neighbors","assertions":[{"type":"cdp_neighbor","device_id":"SW2-DIST","label":"CDP sees SW2-DIST"}],"remediation":["configure terminal","cdp run","interface GigabitEthernet0/1","cdp enable","no shutdown","end"]},
      {"node":"SW1-CORE","command":"show lldp neighbors","assertions":[{"type":"contains","value":"SW2-DIST","label":"LLDP sees SW2-DIST"}],"remediation":["configure terminal","lldp run","interface GigabitEthernet0/1","no shutdown","end"]}
    ]
  },
  {
    "id":"23","schema_version":2,"name":"NTP Configuration","domain":"IP Services","difficulty":"Easy","minutes":20,
    "objective":"Configure a deterministic NTP client relationship and verify the running configuration.",
    "tasks":["Configure R1-EDGE to use 192.0.2.10 as NTP server.","Create Loopback0 10.255.255.1/32 and source NTP from it."],
    "topology":{"nodes":[{"name":"R1-EDGE","template":"vios","left":"45%","top":"40%"}],"links":[]},
    "checks":[{"node":"R1-EDGE","command":"show running-config | include ^ntp|^interface Loopback0|ip address 10.255.255.1","assertions":[{"type":"contains","value":"ntp server 192.0.2.10","label":"NTP server 192.0.2.10"},{"type":"contains","value":"ntp source Loopback0","label":"NTP source Loopback0"},{"type":"contains","value":"ip address 10.255.255.1 255.255.255.255","label":"Loopback0 10.255.255.1/32"}],"remediation":["configure terminal","interface Loopback0","ip address 10.255.255.1 255.255.255.255","exit","ntp source Loopback0","ntp server 192.0.2.10","end"]}]
  },
  {
    "id":"24","schema_version":2,"name":"Syslog Management","domain":"IP Services","difficulty":"Easy","minutes":20,
    "objective":"Configure centralized Syslog and timestamped IOS logging.",
    "tasks":["Configure logging host 192.0.2.20.","Set trap severity to warnings.","Enable millisecond timestamps for log messages."],
    "topology":{"nodes":[{"name":"R2-HQ","template":"vios","left":"45%","top":"40%"}],"links":[]},
    "checks":[{"node":"R2-HQ","command":"show running-config | include ^logging|^service timestamps log","assertions":[{"type":"contains","value":"logging host 192.0.2.20","label":"Syslog host 192.0.2.20"},{"type":"contains","value":"logging trap warnings","label":"Syslog severity warnings"},{"type":"regex","pattern":"service timestamps log datetime.*msec","label":"Millisecond log timestamps"}],"remediation":["configure terminal","service timestamps log datetime msec","logging host 192.0.2.20","logging trap warnings","end"]}]
  },
  {
    "id":"25","schema_version":2,"name":"HSRP First-Hop Redundancy","domain":"IP Connectivity","difficulty":"Bonus","minutes":35,
    "objective":"Build an HSRP pair and verify active and standby gateways.",
    "tasks":["Configure R1-HSRP Gi0/0 10.10.10.2/24 and R2-HSRP Gi0/0 10.10.10.3/24.","Use HSRP group 10 virtual IP 10.10.10.1.","Make R1 preferred active with priority 110 and preempt."],
    "topology":{"nodes":[{"name":"R1-HSRP","template":"vios","left":"20%","top":"30%"},{"name":"R2-HSRP","template":"vios","left":"65%","top":"30%"},{"name":"SW1-ACCESS","template":"viosl2","left":"42%","top":"68%"}],"links":[{"a":"R1-HSRP","a_if":"Gi0/0","b":"SW1-ACCESS","b_if":"Gi0/0"},{"a":"R2-HSRP","a_if":"Gi0/0","b":"SW1-ACCESS","b_if":"Gi0/1"}]},
    "checks":[{"node":"R1-HSRP","command":"show standby brief","assertions":[{"type":"hsrp","interface":"Gi0/0","state":"Active","virtual_ip":"10.10.10.1","label":"R1 active / VIP 10.10.10.1"}]},{"node":"R2-HSRP","command":"show standby brief","assertions":[{"type":"hsrp","interface":"Gi0/0","state":"Standby","virtual_ip":"10.10.10.1","label":"R2 standby / VIP 10.10.10.1"}]}]
  },
  {
    "id":"26","schema_version":2,"name":"SNMP Operations","domain":"IP Services","difficulty":"Medium","minutes":25,
    "objective":"Configure basic read-only SNMP and identify the managed device.",
    "tasks":["Configure community CCNA-RO as read-only.","Set location LAB.","Set contact admin@ccna.lab."],
