[
  {
    "id": "01",
    "name": "Initial Configuration",
    "domain": "Network Fundamentals",
    "difficulty": "Easy",
    "minutes": 20,
    "objective": "Configure baseline IOS management and verify device identity.",
    "tasks": [
      "Set the hostname on R1-EDGE.",
      "Disable DNS lookup.",
      "Configure a local admin user.",
      "Enable SSH version 2."
    ],
    "checks": [
      {
        "node": "R1-EDGE",
        "command": "show running-config | include hostname",
        "contains": [
          "hostname R1-EDGE"
        ]
      },
      {
        "node": "R1-EDGE",
        "command": "show ip ssh",
        "contains": [
          "SSH Enabled"
        ]
      }
    ]
  },
  {
    "id": "02",
    "name": "IPv4 Addressing",
    "domain": "Network Fundamentals",
    "difficulty": "Easy",
    "minutes": 30,
    "objective": "Configure and verify IPv4 addressing on routed links.",
    "tasks": [
      "Address R1-EDGE Gi0/0 as 10.0.12.1/30.",
      "Address R2-HQ Gi0/0 as 10.0.12.2/30.",
      "Verify bidirectional reachability."
    ],
    "checks": [
      {
        "node": "R1-EDGE",
        "command": "show ip interface brief",
        "contains": [
          "10.0.12.1"
        ]
      },
      {
        "node": "R2-HQ",
        "command": "show ip interface brief",
        "contains": [
          "10.0.12.2"
        ]
      }
    ]
  },
  {
    "id": "03",
    "name": "IPv6",
    "domain": "Network Fundamentals",
    "difficulty": "Medium",
    "minutes": 30,
    "objective": "Configure global unicast and link-local IPv6 connectivity.",
    "tasks": [
      "Enable IPv6 unicast routing.",
      "Use 2001:db8:12::/64 on R1-R2.",
      "Verify IPv6 neighbor discovery."
    ],
    "checks": [
      {
        "node": "R1-EDGE",
        "command": "show ipv6 interface brief",
        "contains": [
          "2001:DB8:12::1"
        ]
      }
    ]
  },
  {
    "id": "04",
    "name": "VLAN",
    "domain": "Network Access",
    "difficulty": "Easy",
    "minutes": 25,
    "objective": "Create the enterprise VLAN set on SW3-ACCESS.",
    "tasks": [
      "Create VLANs 10 USERS, 20 SERVERS, 30 VOICE, 40 GUEST and 99 MANAGEMENT.",
      "Verify the VLAN database."
    ],
    "checks": [
      {
        "node": "SW3-ACCESS",
        "command": "show vlan brief",
        "contains": [
          "10",
          "USERS",
          "20",
          "SERVERS",
          "99",
          "MANAGEMENT"
        ]
      }
    ]
  },
  {
    "id": "05",
    "name": "802.1Q Trunking",
    "domain": "Network Access",
    "difficulty": "Medium",
    "minutes": 30,
    "objective": "Build an 802.1Q trunk between SW1-CORE and SW2-DIST.",
    "tasks": [
      "Configure Gi0/1 as a trunk on both switches.",
      "Use VLAN 99 as native VLAN.",
      "Allow VLANs 10,20,30,40,99."
    ],
    "checks": [
      {
        "node": "SW1-CORE",
        "command": "show interfaces trunk",
        "contains": [
          "Gi0/1",
          "99"
        ]
      },
      {
        "node": "SW2-DIST",
        "command": "show interfaces trunk",
        "contains": [
          "Gi0/1",
          "99"
        ]
      }
    ]
  },
  {
    "id": "06",
    "name": "EtherChannel",
    "domain": "Network Access",
    "difficulty": "Medium",
    "minutes": 35,
    "objective": "Configure a Layer-2 LACP EtherChannel.",
    "tasks": [
      "Use two available links between the core/distribution switches.",
      "Create Port-channel1 using LACP active mode.",
      "Make Po1 an 802.1Q trunk."
    ],
    "checks": [
      {
        "node": "SW1-CORE",
        "command": "show etherchannel summary",
        "contains": [
          "Po1",
          "LACP"
        ]
      }
    ]
  },
  {
    "id": "07",
    "name": "STP / RSTP",
    "domain": "Network Access",
    "difficulty": "Medium",
    "minutes": 30,
    "objective": "Control Rapid-PVST root bridge placement.",
    "tasks": [
      "Use rapid-pvst.",
      "Make SW1-CORE root primary for VLANs 10,20,99.",
      "Verify root roles."
    ],
    "checks": [
      {
        "node": "SW1-CORE",
        "command": "show spanning-tree root",
        "contains": [
          "Vl10",
          "Vl20",
          "Vl99"
        ]
      }
    ]
  },
  {
    "id": "08",
    "name": "Inter-VLAN Routing",
    "domain": "IP Connectivity",
    "difficulty": "Medium",
    "minutes": 40,
    "objective": "Provide Layer-3 connectivity between user and server VLANs.",
    "tasks": [
      "Implement router-on-a-stick or SVIs using the available topology.",
      "Use 10.10.10.1/24 for VLAN10 and 10.20.20.1/24 for VLAN20.",
      "Verify routing."
    ],
    "checks": [
      {
        "node": "R2-HQ",
        "command": "show ip interface brief",
        "contains": [
          "10.10.10.1",
          "10.20.20.1"
        ]
      }
    ]
  },
  {
    "id": "09",
    "name": "Static Routing",
    "domain": "IP Connectivity",
    "difficulty": "Medium",
    "minutes": 35,
    "objective": "Configure primary, default and floating static routes.",
    "tasks": [
      "Configure a default route on R4-BRANCH toward HQ.",
      "Configure a floating backup route with higher AD.",
      "Verify the routing table."
    ],
    "checks": [
      {
        "node": "R4-BRANCH",
        "command": "show ip route static",
        "contains": [
          "S"
        ]
      }
    ]
  },
  {
    "id": "10",
    "name": "OSPF",
    "domain": "IP Connectivity",
    "difficulty": "Medium",
    "minutes": 45,
    "objective": "Build single-area OSPFv2 between the routed core devices.",
    "tasks": [
      "Use process 10, area 0.",
      "Set deterministic router IDs.",
      "Make user-facing interfaces passive.",
      "Verify full adjacencies."
    ],
    "checks": [
      {
        "node": "R2-HQ",
        "command": "show ip ospf neighbor",
        "contains": [
          "FULL"
        ]
      },
      {
        "node": "R3-HQ",
        "command": "show ip protocols",
        "contains": [
          "ospf 10"
        ]
      }
    ]
  },
  {
    "id": "11",
    "name": "DHCP",
    "domain": "IP Services",
    "difficulty": "Medium",
    "minutes": 35,
    "objective": "Serve VLAN10 clients using Cisco IOS DHCP.",
    "tasks": [
